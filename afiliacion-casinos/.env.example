# Copia este archivo a .env y rellena SOLO en tu equipo. Nunca subas .env a Git.
# URL pública del sitio (cuando exista el dominio)
SITE_URL=https://juegoverificado.example
# Token público del beacon de Cloudflare Web Analytics (no es secreto, pero se configura por entorno)
PUBLIC_CF_BEACON_TOKEN=
# Nombre del proyecto en Cloudflare Pages (para `make deploy`)
CF_PAGES_PROJECT=
# Credenciales de Cloudflare para wrangler (preferible: `npx wrangler login`)
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# API de Claude: solo para scripts/pipeline.py (automatización desatendida)
ANTHROPIC_API_KEY=
# Alertas de n8n
ALERT_EMAIL=
ALERT_FROM=
